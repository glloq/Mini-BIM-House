{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/assembly.schema.json",
  "title": "Assembly Definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "layers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "WALL",
        "ROOF",
        "FLOOR",
        "CEILING",
        "PARTITION",
        "OTHER"
      ]
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "materialId",
          "thicknessM"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "materialId": {
            "type": "string",
            "minLength": 1
          },
          "thicknessM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "role": {
            "type": "string"
          },
          "ventilated": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

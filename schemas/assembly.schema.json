{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/assembly.schema.json",
  "title": "Assembly Definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "category"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "catalogRef": {
      "type": "object",
      "required": [
        "registry",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "WALL",
        "ROOF",
        "FLOOR",
        "CEILING",
        "PARTITION",
        "STRUCTURAL_MEMBER",
        "ROOF_PART",
        "OTHER"
      ]
    },
    "layers": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "materialId",
          "thicknessM"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "materialId": {
            "type": "string",
            "minLength": 1
          },
          "thicknessM": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "role": {
            "type": "string"
          },
          "ventilated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "form": {
      "enum": [
        "LAYERED",
        "PROFILED",
        "LINEAR"
      ]
    },
    "properties": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

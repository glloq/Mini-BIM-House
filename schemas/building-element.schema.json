{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/building-element.schema.json",
  "title": "Building elements",
  "$defs": {
    "Wall": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "path",
        "referenceSide",
        "assemblyId",
        "baseOffsetMm",
        "heightMode",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "WALL"
        },
        "levelId": {
          "type": "string"
        },
        "path": {
          "type": "object",
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
              }
            }
          },
          "additionalProperties": false
        },
        "referenceSide": {
          "enum": [
            "CENTER",
            "LEFT",
            "RIGHT"
          ]
        },
        "assemblyId": {
          "type": "string"
        },
        "baseOffsetMm": {
          "type": "number"
        },
        "heightMode": {
          "enum": [
            "EXPLICIT",
            "TO_LEVEL"
          ]
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "topLevelId": {
          "type": "string"
        },
        "topOffsetMm": {
          "type": "number"
        },
        "role": {
          "enum": [
            "EXTERIOR",
            "INTERIOR",
            "PARTITION",
            "OTHER"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "heightMode": {
                "const": "EXPLICIT"
              }
            },
            "additionalProperties": false
          },
          "then": {
            "properties": {
              "heightMm": {}
            },
            "required": [
              "heightMm"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "heightMode": {
                "const": "TO_LEVEL"
              }
            },
            "additionalProperties": false
          },
          "then": {
            "properties": {
              "topLevelId": {}
            },
            "required": [
              "topLevelId"
            ],
            "additionalProperties": false
          }
        }
      ],
      "additionalProperties": false
    },
    "Opening": {
      "description": "Ce qu'une ouverture perce, et comment elle s'y repère. Deux formes plutôt qu'une : une baie verticale se donne le long d'un mur et par son allège, une fenêtre de toit dans le plan du pan. Les réunir dans les mêmes champs serait mentir sur ce qu'ils mesurent.",
      "oneOf": [
        {
          "type": "object",
          "description": "Une baie percée dans un mur : elle se repère par une distance le long du mur et par son allège.",
          "required": [
            "id",
            "type",
            "openingType",
            "host",
            "offsetAlongHostMm",
            "sillHeightMm",
            "widthMm",
            "heightMm"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "const": "OPENING"
            },
            "openingType": {
              "enum": [
                "DOOR",
                "WINDOW",
                "VOID",
                "OTHER"
              ]
            },
            "widthMm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heightMm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "definitionId": {
              "type": "string"
            },
            "swing": {
              "type": "object",
              "description": "Which way a door opens, stated against its host wall's own path rather than against the screen.",
              "required": [
                "hinge",
                "opensTo"
              ],
              "properties": {
                "hinge": {
                  "enum": [
                    "START",
                    "END"
                  ]
                },
                "opensTo": {
                  "enum": [
                    "LEFT_OF_HOST",
                    "RIGHT_OF_HOST"
                  ]
                },
                "openingAngleDeg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 180
                }
              },
              "additionalProperties": false
            },
            "host": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "const": "WALL"
                },
                "id": {
                  "type": "string"
                }
              }
            },
            "offsetAlongHostMm": {
              "type": "number",
              "minimum": 0
            },
            "sillHeightMm": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Une fenêtre percée dans un pan de toiture : elle se repère dans le plan du pan, le long de l'égout et en remontant le rampant. `upSlopeMm` est une longueur vraie, mesurée dans le plan incliné et non sa projection au sol — c'est ainsi qu'une fenêtre de toit est vendue et posée, et c'est la seule mesure qui reste juste quand la pente change.",
          "required": [
            "id",
            "type",
            "openingType",
            "host",
            "placement",
            "widthMm",
            "heightMm"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "const": "OPENING"
            },
            "openingType": {
              "enum": [
                "DOOR",
                "WINDOW",
                "VOID",
                "OTHER"
              ]
            },
            "widthMm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heightMm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "definitionId": {
              "type": "string"
            },
            "swing": {
              "type": "object",
              "description": "Which way a door opens, stated against its host wall's own path rather than against the screen.",
              "required": [
                "hinge",
                "opensTo"
              ],
              "properties": {
                "hinge": {
                  "enum": [
                    "START",
                    "END"
                  ]
                },
                "opensTo": {
                  "enum": [
                    "LEFT_OF_HOST",
                    "RIGHT_OF_HOST"
                  ]
                },
                "openingAngleDeg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 180
                }
              },
              "additionalProperties": false
            },
            "host": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "const": "ROOF"
                },
                "id": {
                  "type": "string"
                }
              }
            },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "alongEaveMm",
                "upSlopeMm"
              ],
              "properties": {
                "alongEaveMm": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Le long de l'égout, depuis son premier sommet."
                },
                "upSlopeMm": {
                  "type": "number",
                  "minimum": 0,
                  "description": "En remontant le rampant depuis l'égout, en longueur vraie."
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Slab": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "polygon",
        "assemblyId",
        "elevationOffsetMm",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "SLAB"
        },
        "levelId": {
          "type": "string"
        },
        "polygon": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "assemblyId": {
          "type": "string"
        },
        "elevationOffsetMm": {
          "type": "number"
        },
        "role": {
          "enum": [
            "FLOOR",
            "CEILING",
            "FOUNDATION",
            "TERRACE",
            "OTHER"
          ]
        }
      },
      "additionalProperties": false
    },
    "Space": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "name",
        "category",
        "boundaryMode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "SPACE"
        },
        "levelId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "boundaryMode": {
          "enum": [
            "AUTO",
            "MANUAL"
          ]
        },
        "manualPolygon": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "usageProfileId": {
          "type": "string"
        },
        "thermalZoneId": {
          "type": "string"
        },
        "anchor": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
        },
        "labelOffsetMm": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
        }
      },
      "additionalProperties": false
    },
    "RoofPlane": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "footprint",
        "assemblyId",
        "slopeDeg",
        "azimuthDeg",
        "baseElevationMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ROOF_PLANE"
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "footprint": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "assemblyId": {
          "type": "string",
          "minLength": 1
        },
        "slopeDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 90
        },
        "azimuthDeg": {
          "type": "number"
        },
        "baseElevationMm": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "WallEndpointReference": {
      "type": "object",
      "required": [
        "kind",
        "wallId",
        "endpoint"
      ],
      "properties": {
        "kind": {
          "const": "WALL_ENDPOINT"
        },
        "wallId": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "enum": [
            "START",
            "END"
          ]
        }
      },
      "additionalProperties": false
    },
    "Dimension": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "type",
        "first",
        "second",
        "offsetMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "DIMENSION"
        },
        "type": {
          "enum": [
            "ALIGNED",
            "HORIZONTAL",
            "VERTICAL"
          ]
        },
        "first": {
          "$ref": "#/$defs/WallEndpointReference"
        },
        "second": {
          "$ref": "#/$defs/WallEndpointReference"
        },
        "offsetMm": {
          "type": "number"
        },
        "overrideText": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TextNote": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "at",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "TEXT"
        },
        "at": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationDeg": {
          "type": "number"
        },
        "leaderTo": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
        }
      },
      "additionalProperties": false
    },
    "Annotation": {
      "oneOf": [
        {
          "$ref": "#/$defs/Dimension"
        },
        {
          "$ref": "#/$defs/TextNote"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Wall"
    },
    {
      "$ref": "#/$defs/Opening"
    },
    {
      "$ref": "#/$defs/Slab"
    },
    {
      "$ref": "#/$defs/Space"
    },
    {
      "$ref": "#/$defs/RoofPlane"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/building-element.schema.json",
  "title": "Building elements",
  "$defs": {
    "Wall": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "path",
        "referenceSide",
        "assemblyId",
        "baseOffsetMm",
        "heightMode",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "WALL"
        },
        "levelId": {
          "type": "string"
        },
        "path": {
          "type": "object",
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
              }
            }
          },
          "additionalProperties": false
        },
        "referenceSide": {
          "enum": [
            "CENTER",
            "LEFT",
            "RIGHT"
          ]
        },
        "assemblyId": {
          "type": "string"
        },
        "baseOffsetMm": {
          "type": "number"
        },
        "heightMode": {
          "enum": [
            "EXPLICIT",
            "TO_LEVEL"
          ]
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "topLevelId": {
          "type": "string"
        },
        "topOffsetMm": {
          "type": "number"
        },
        "role": {
          "enum": [
            "EXTERIOR",
            "INTERIOR",
            "PARTITION",
            "OTHER"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "heightMode": {
                "const": "EXPLICIT"
              }
            }
          },
          "then": {
            "properties": {
              "heightMm": {}
            },
            "required": [
              "heightMm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "heightMode": {
                "const": "TO_LEVEL"
              }
            }
          },
          "then": {
            "properties": {
              "topLevelId": {}
            },
            "required": [
              "topLevelId"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "Opening": {
      "type": "object",
      "required": [
        "id",
        "type",
        "openingType",
        "hostElementId",
        "offsetAlongHostMm",
        "sillHeightMm",
        "widthMm",
        "heightMm"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "OPENING"
        },
        "openingType": {
          "enum": [
            "DOOR",
            "WINDOW",
            "VOID",
            "OTHER"
          ]
        },
        "hostElementId": {
          "type": "string"
        },
        "offsetAlongHostMm": {
          "type": "number",
          "minimum": 0
        },
        "sillHeightMm": {
          "type": "number"
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "definitionId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Slab": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "polygon",
        "assemblyId",
        "elevationOffsetMm",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "SLAB"
        },
        "levelId": {
          "type": "string"
        },
        "polygon": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "assemblyId": {
          "type": "string"
        },
        "elevationOffsetMm": {
          "type": "number"
        },
        "role": {
          "enum": [
            "FLOOR",
            "FOUNDATION",
            "TERRACE",
            "OTHER"
          ]
        }
      },
      "additionalProperties": true
    },
    "Space": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "name",
        "category",
        "boundaryMode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "SPACE"
        },
        "levelId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "boundaryMode": {
          "enum": [
            "AUTO",
            "MANUAL"
          ]
        },
        "manualPolygon": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "usageProfileId": {
          "type": "string"
        },
        "thermalZoneId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "RoofPlane": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "footprint",
        "assemblyId",
        "slopeDeg",
        "azimuthDeg",
        "baseElevationMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ROOF_PLANE"
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "footprint": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "assemblyId": {
          "type": "string",
          "minLength": 1
        },
        "slopeDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 90
        },
        "azimuthDeg": {
          "type": "number"
        },
        "baseElevationMm": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "WallEndpointReference": {
      "type": "object",
      "required": [
        "kind",
        "wallId",
        "endpoint"
      ],
      "properties": {
        "kind": {
          "const": "WALL_ENDPOINT"
        },
        "wallId": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "enum": [
            "START",
            "END"
          ]
        }
      },
      "additionalProperties": false
    },
    "Dimension": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "type",
        "first",
        "second",
        "offsetMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "DIMENSION"
        },
        "type": {
          "enum": [
            "ALIGNED",
            "HORIZONTAL",
            "VERTICAL"
          ]
        },
        "first": {
          "$ref": "#/$defs/WallEndpointReference"
        },
        "second": {
          "$ref": "#/$defs/WallEndpointReference"
        },
        "offsetMm": {
          "type": "number"
        },
        "overrideText": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Wall"
    },
    {
      "$ref": "#/$defs/Opening"
    },
    {
      "$ref": "#/$defs/Slab"
    },
    {
      "$ref": "#/$defs/Space"
    },
    {
      "$ref": "#/$defs/RoofPlane"
    }
  ]
}

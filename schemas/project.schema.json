{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/project.schema.json",
  "title": "House Technical Designer Project",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "project"
  ],
  "properties": {
    "format": {
      "const": "house-technical-designer-project"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "applicationVersion": {
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "references": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Project": {
      "type": "object",
      "required": [
        "id",
        "metadata",
        "site",
        "building"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "required": [
            "name",
            "createdAt",
            "updatedAt"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            },
            "projectRevision": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "site": {
          "type": "object",
          "required": [
            "northAngleDeg"
          ],
          "properties": {
            "northAngleDeg": {
              "type": "number"
            },
            "locationLabel": {
              "type": "string"
            },
            "altitudeM": {
              "type": "number"
            },
            "climateProfileId": {
              "type": "string"
            },
            "parcelBoundary": {
              "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
            },
            "obstacles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "boundary"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "boundary": {
                    "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
                  },
                  "heightMm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "kind": {
                    "enum": [
                      "BUILDING",
                      "TREE",
                      "EXCLUSION",
                      "PATH",
                      "PARKING",
                      "ROAD",
                      "TERRACE",
                      "FENCE",
                      "HEDGE",
                      "GATE",
                      "OTHER"
                    ]
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "building": {
          "type": "object",
          "required": [
            "levels",
            "zones"
          ],
          "properties": {
            "levels": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Level"
              }
            },
            "zones": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Zone"
              }
            }
          },
          "additionalProperties": true
        },
        "materialLibrary": {
          "type": "object",
          "required": [
            "materials"
          ],
          "properties": {
            "materials": {
              "type": "array",
              "items": {
                "$ref": "https://house-technical-designer.local/schemas/material.schema.json"
              }
            }
          },
          "additionalProperties": false
        },
        "assemblies": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/assembly.schema.json"
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/equipment.schema.json"
          }
        },
        "openingTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpeningDefinition"
          }
        },
        "networkProducts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "family",
              "domain",
              "label",
              "properties"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "properties": {
                "type": "object"
              },
              "provenance": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "validAt": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/network.schema.json"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/scenario.schema.json"
          }
        },
        "calculationSettings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://house-technical-designer.local/schemas/module-settings.schema.json"
          }
        },
        "drawingViews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SavedDrawingView"
          }
        },
        "regulatoryContext": {
          "type": "object",
          "required": [
            "country",
            "enabledRulePacks"
          ],
          "properties": {
            "country": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string"
            },
            "projectType": {
              "type": "string"
            },
            "referenceDate": {
              "type": "string"
            },
            "enabledRulePacks": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string"
                      },
                      "applicability": {
                        "type": "string"
                      },
                      "sourceReference": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "additionalProperties": true
        },
        "sheets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectSheet"
          }
        },
        "scope": {
          "$ref": "#/$defs/ProjectScope"
        }
      },
      "additionalProperties": true
    },
    "ProjectScope": {
      "type": "object",
      "required": [
        "intent",
        "enabledDomains"
      ],
      "properties": {
        "intent": {
          "enum": [
            "NEW_BUILD",
            "RENOVATION",
            "EXISTING_SURVEY",
            "STUDY"
          ]
        },
        "enabledDomains": {
          "type": "array",
          "items": {
            "enum": [
              "ARCHITECTURE",
              "STRUCTURE",
              "SITE",
              "PLUMBING",
              "WASTEWATER",
              "RAINWATER",
              "HEATING",
              "VENTILATION",
              "ELECTRICAL",
              "LIGHTING",
              "SOLAR",
              "STORAGE",
              "FLUE",
              "DATA",
              "SAFETY",
              "FURNITURE"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "Level": {
      "type": "object",
      "required": [
        "id",
        "name",
        "elevationMm",
        "defaultStoreyHeightMm",
        "walls",
        "slabs",
        "roofs",
        "openings",
        "stairs",
        "spaces",
        "annotations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "elevationMm": {
          "type": "number"
        },
        "defaultStoreyHeightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/building-element.schema.json#/$defs/Wall"
          }
        },
        "slabs": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/building-element.schema.json#/$defs/Slab"
          }
        },
        "roofs": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/building-element.schema.json#/$defs/RoofPlane"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/building-element.schema.json#/$defs/Opening"
          }
        },
        "spaces": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/building-element.schema.json#/$defs/Space"
          }
        },
        "stairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stair"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/building-element.schema.json#/$defs/Annotation"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentInstance"
          }
        },
        "roofStructures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoofStructure"
          }
        },
        "structure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuralMember"
          }
        }
      },
      "additionalProperties": true
    },
    "Zone": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "spaceIds",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "THERMAL",
            "VENTILATION",
            "ELECTRICAL",
            "ACOUSTIC",
            "LIGHTING",
            "FIRE",
            "WATER",
            "SECURITY",
            "CUSTOM"
          ]
        },
        "name": {
          "type": "string"
        },
        "spaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "ComponentInstance": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "category",
        "position",
        "elevationMm",
        "rotationDeg"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "COMPONENT_INSTANCE"
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "HEATING",
            "SANITARY",
            "VENTILATION",
            "ELECTRICAL",
            "LIGHTING",
            "PHOTOVOLTAIC",
            "APPLIANCE",
            "FURNITURE",
            "OTHER"
          ]
        },
        "definitionId": {
          "type": "string",
          "minLength": 1
        },
        "definitionVersion": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
        },
        "elevationMm": {
          "type": "number"
        },
        "rotationDeg": {
          "type": "number"
        },
        "hostObjectId": {
          "type": "string",
          "minLength": 1
        },
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "Stair": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "topLevelId",
        "stairType",
        "widthMm",
        "riserCount",
        "treadDepthMm",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "STAIR"
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "topLevelId": {
          "type": "string",
          "minLength": 1
        },
        "stairType": {
          "enum": [
            "STRAIGHT",
            "L_SHAPED",
            "U_SHAPED",
            "SPIRAL"
          ]
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "riserCount": {
          "type": "integer",
          "minimum": 2
        },
        "treadDepthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "path": {
          "type": "object",
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
              }
            }
          },
          "additionalProperties": true
        },
        "landings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "afterRiser",
              "depthMm"
            ],
            "properties": {
              "afterRiser": {
                "type": "integer",
                "minimum": 1
              },
              "depthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "RoofStructure": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "footprint",
        "edges",
        "assemblyId",
        "baseElevationMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ROOF"
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "footprint": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Polygon2D"
        },
        "edges": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "slopeDeg",
              "overhangMm"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "SLOPED",
                  "GABLE"
                ]
              },
              "slopeDeg": {
                "type": "number"
              },
              "overhangMm": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "assemblyId": {
          "type": "string",
          "minLength": 1
        },
        "baseElevationMm": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "SavedDrawingView": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "scaleDenominator",
        "layers",
        "graphicProfileId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "PLAN",
            "SECTION",
            "ELEVATION",
            "ROOF",
            "SITE"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "scaleDenominator": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "graphicProfileId": {
          "type": "string",
          "minLength": 1
        },
        "centreMm": {
          "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
        },
        "analysisOverlayId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ProjectSheet": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "format",
        "orientation",
        "viewports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "A4",
            "A3",
            "A2",
            "A1",
            "A0"
          ]
        },
        "orientation": {
          "enum": [
            "PORTRAIT",
            "LANDSCAPE"
          ]
        },
        "revision": {
          "type": "string"
        },
        "colorMode": {
          "enum": [
            "COLOR",
            "GRAYSCALE"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "viewId",
              "scaleDenominator",
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "viewId": {
                "type": "string",
                "minLength": 1
              },
              "scaleDenominator": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "StructuralMember": {
      "type": "object",
      "required": [
        "id",
        "type",
        "levelId",
        "kind",
        "path",
        "widthMm",
        "depthMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "STRUCTURAL_MEMBER"
        },
        "levelId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "COLUMN",
            "BEAM",
            "FOOTING"
          ]
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point2D"
          }
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elevationMm": {
          "type": "number"
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "materialId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "OpeningDefinition": {
      "type": "object",
      "required": [
        "id",
        "category",
        "name",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string"
        },
        "category": {
          "enum": [
            "WINDOW",
            "DOOR",
            "SOLAR_PROTECTION"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "provenance": {
          "type": "object",
          "required": [
            "type",
            "reference"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "validAt": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "property",
              "sourceType",
              "reference"
            ],
            "properties": {
              "property": {
                "type": "string"
              },
              "sourceType": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "validAt": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}

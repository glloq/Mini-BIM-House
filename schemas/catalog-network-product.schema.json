{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/catalog-network-product.schema.json",
  "title": "Network product catalogue file",
  "type": "object",
  "required": [
    "products"
  ],
  "additionalProperties": false,
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "domain",
          "label",
          "version",
          "properties",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "family": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "domain": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "properties": {
            "type": "object"
          },
          "provenance": {
            "type": "object",
            "required": [
              "type",
              "reference"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "validAt": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

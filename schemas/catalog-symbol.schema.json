{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/catalog-symbol.schema.json",
  "title": "Symbol catalogue file",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "version",
    "licence",
    "symbols"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "semanticType",
          "discipline",
          "provenance",
          "viewBox",
          "anchors",
          "primitives",
          "scaleRules"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "semanticType": {
            "type": "string",
            "minLength": 1
          },
          "discipline": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "required": [
              "type",
              "reference"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              },
              "validAt": {
                "type": "string"
              }
            }
          },
          "viewBox": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "max": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "point",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "point": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                },
                "kind": {
                  "enum": [
                    "INSERTION",
                    "CONNECTION",
                    "LABEL"
                  ]
                }
              }
            }
          },
          "primitives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "role"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "LINE",
                    "POLYLINE",
                    "POLYGON",
                    "CIRCLE",
                    "ARC",
                    "TEXT"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "start": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                },
                "end": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  }
                },
                "center": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "startAngleDeg": {
                  "type": "number"
                },
                "endAngleDeg": {
                  "type": "number"
                },
                "anchor": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "scaleRules": {
            "type": "object",
            "required": [
              "space"
            ],
            "additionalProperties": false,
            "properties": {
              "space": {
                "enum": [
                  "MODEL_SPACE",
                  "PAPER_SPACE"
                ]
              },
              "nominalSizeMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}

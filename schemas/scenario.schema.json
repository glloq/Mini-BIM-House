{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/scenario.schema.json",
  "title": "Project scenario",
  "type": "object",
  "required": [
    "id",
    "name",
    "baseProjectRevision",
    "overrides"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "baseProjectRevision": {
      "type": "string"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "operation"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "SET",
              "ADD",
              "REMOVE",
              "REPLACE_REFERENCE"
            ]
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "enabledModules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/equipment.schema.json",
  "title": "Equipment definition",
  "type": "object",
  "required": [
    "id",
    "kind",
    "catalogKind",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "familyId": {
      "type": "string"
    },
    "allowedHosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "type": "string"
    },
    "catalogKind": {
      "enum": [
        "GENERIC",
        "PRODUCT",
        "CUSTOM"
      ]
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "discipline",
          "role",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "portTypeId": {
            "type": "string"
          },
          "discipline": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "position": {
            "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Point3D"
          },
          "direction": {
            "$ref": "https://house-technical-designer.local/schemas/geometry.schema.json#/$defs/Vector3D"
          },
          "connectionType": {
            "type": "string"
          },
          "nominalSize": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "properties": {
      "type": "object"
    },
    "performanceCurves": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "clearances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "zone"
        ],
        "properties": {
          "zone": {
            "type": "string"
          },
          "frontMm": {
            "type": "number",
            "minimum": 0
          },
          "backMm": {
            "type": "number",
            "minimum": 0
          },
          "leftMm": {
            "type": "number",
            "minimum": 0
          },
          "rightMm": {
            "type": "number",
            "minimum": 0
          },
          "aboveMm": {
            "type": "number",
            "minimum": 0
          },
          "belowMm": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

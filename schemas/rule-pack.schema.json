{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-technical-designer.local/schemas/rule-pack.schema.json",
  "title": "Rule Pack",
  "type": "object",
  "required": [
    "id",
    "version",
    "jurisdiction",
    "validity",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "object",
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "validity": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "LAW",
              "REGULATION",
              "STANDARD",
              "DTU",
              "GUIDELINE",
              "DATA_SOURCE",
              "OTHER"
            ]
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "appliesTo",
          "evaluator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "ERROR",
              "WARNING",
              "INFO"
            ]
          },
          "appliesTo": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluator": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "DECLARATIVE",
                  "JSON_LOGIC",
                  "MODULE_FUNCTION"
                ]
              },
              "expression": {},
              "functionId": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

{
  "name": "house-technical-designer",
  "version": "0.3.0-beta.12",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "benchmark": "vitest bench --run",
    "dev": "npm run dev --workspace=@house-technical-designer/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "validate:schemas": "node scripts/generate-project-validator.mjs --check && node scripts/validate-schemas.mjs",
    "validate:catalog": "vite-node scripts/validate-catalog.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json && tsc -p scripts/tsconfig.json",
    "generate:project-validator": "node scripts/generate-project-validator.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "catalog:status": "vite-node scripts/catalog-status.ts",
    "catalog:fingerprints": "vite-node scripts/catalog-fingerprints.ts",
    "catalog:manifest": "vite-node scripts/catalog-manifest.ts",
    "test:discovery": "vitest run --config vitest.discovery.config.ts",
    "validate:docs": "node scripts/validation-report.mjs --check",
    "test:coverage": "vitest run --coverage",
    "catalog:starter": "vite-node scripts/starter-library.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}

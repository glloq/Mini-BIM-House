      [0, 0],
      [4000, 0]
    ],
    "second": [
      [4000, 0],
      [4000, 3000]
    ],
    "expectedKind": "L",
    "expectedPoint": [4000, 0]
  },
  {
    "name": "endpoint against interior T",
    "first": [
      [2000, -1000],

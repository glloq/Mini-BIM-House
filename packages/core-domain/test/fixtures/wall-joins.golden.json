    ],
    "second": [
      [0, 0],
      [4000, 0]
    ],
    "expectedKind": "T",
    "expectedPoint": [2000, 0]
  },
  {
    "name": "interior crossing X",
    "first": [
      [0, 0],
      [4000, 0]
    ],
    "second": [
      [2000, -1000],
      [2000, 1000]
    ],
    "expectedKind": "X",
    "expectedPoint": [2000, 0]
  },
  {
    "name": "collinear endpoint",
    "first": [
      [0, 0],
      [2000, 0]
    ],
    "second": [
      [2000, 0],
      [4000, 0]
    ],
    "expectedKind": "COLLINEAR",
    "expectedPoint": [2000, 0]
